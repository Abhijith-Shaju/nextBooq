# Environment Variables Configuration
#
# NEXT_PUBLIC_* variables are inlined into the client JS bundle at build
# time, not read at request time — changing one of these later requires a
# rebuild (a new `next build` / `npm run dev` restart), not just a redeploy
# of the same build output or an env change on a running process.

# Origin of the backend API. Requests from the browser (axios-instance.ts)
# and the server-rendered tenant layouts both target this origin directly —
# there is no Next.js rewrite/proxy in front of the backend anymore. Left
# unset, browser API calls resolve against this app's own origin instead
# and 404 against Next's own HTML 404 page rather than reaching the
# backend, which is easy to mistake for an auth failure.
NEXT_PUBLIC_API_URL=http://localhost:5000

# Must match backend/.env's RAZORPAY_KEY_ID (the Key ID is safe to expose
# client-side by Razorpay's own design — it's the Key Secret that must never
# leave the backend). If these two don't match the same Razorpay account/mode,
# checkout.js opens with a key the order wasn't created under and Razorpay
# fails the payment immediately.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_key_id
