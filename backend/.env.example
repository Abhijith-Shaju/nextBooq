# Environment Variables Configuration
PORT=5000
NODE_ENV=development
# Local development: use the single-node replica set from ../compose.yaml.
# `directConnection=true` is local-only; do not use it for Atlas/production URIs.
MONGO_URI=mongodb://localhost:27017/nextbooq?replicaSet=rs0&directConnection=true
# Must be at least 32 characters. Rotating this value logs out every
# signed-in user immediately — there is no token revocation store, so an
# already-issued JWT simply fails signature verification on its next
# request rather than being individually invalidated. Plan rotations
# accordingly; there is currently no graceful way to stage one.
JWT_SECRET=super_secret_jwt_key_nextbooq_2026
# RAZORPAY_KEY_ID=rzp_test_key_id
# RAZORPAY_KEY_SECRET is kept (not commented out): verifyCheckoutPayment's
# development mock-order signature-verification fallback still reads it.
RAZORPAY_KEY_SECRET=rzp_test_key_secret
# RAZORPAY_WEBHOOK_SECRET removed: webhooks are now verified per-cafe (see
# Cafe.payments.razorpay_webhook_secret_encrypted).
# RAZORPAY_WEBHOOK_SECRET=rzp_test_webhook_secret
# 32-byte key (any string; hashed to 32 bytes internally) used to encrypt
# each cafe's Razorpay Key Secret and webhook secret at rest. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
# Comma-separated list of browser origins allowed to make credentialed
# requests to this API (e.g. https://app.example.com,https://admin.example.com).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Number of reverse proxy hops in front of this process (or a trust-proxy
# keyword like "loopback"), so req.ip resolves to the real client IP for
# rate limiting/audit logs instead of the proxy's IP. Leave at 0 if this
# process is directly exposed (no reverse proxy/load balancer in front of it).
TRUST_PROXY=0
# Resend API key for sending transactional email (password reset, etc.).
# Leave unset locally — emailService will log reset links to the console
# instead of sending real email.
RESEND_API_KEY=
# Sender address for transactional email. Defaults to Resend's shared
# sandbox sender if unset — replace with a domain verified in your Resend
# account before going to production.
FROM_EMAIL=nextBooq <onboarding@resend.dev>
# Public origin of the frontend, used to build links inside emails.
FRONTEND_URL=http://localhost:3000
